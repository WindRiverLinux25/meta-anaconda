From f29cc09d8f84014694ca13d4d3e59ec237f65e24 Mon Sep 17 00:00:00 2001
From: Hongxu Jia <hongxu.jia@windriver.com>
Date: Mon, 24 Jun 2019 11:14:43 +0800
Subject: [PATCH] do not build po and doc

Upstream-Status: Inappropriate [oe specific]

Signed-off-by: Hongxu Jia <hongxu.jia@windriver.com>

Rebased for Fedora 37.

Signed-off-by: Kai Kang <kai.kang@windriver.com>

Rebased for anaconda 42 on 20250328.

Signed-off-by: Kai Kang <kai.kang@windriver.com>
---
 Makefile.am         | 2 +-
 configure.ac        | 2 --
 widgets/Makefile.am | 2 +-
 3 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index cddc78f5de..3ef9f958e0 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -20,7 +20,7 @@ include ./po/l10n-config.mk
 
 ACLOCAL_AMFLAGS = -I m4
 
-SUBDIRS = data docs dracut po pyanaconda scripts tests widgets
+SUBDIRS = data dracut pyanaconda scripts tests widgets
 
 EXTRA_DIST = COPYING
 
diff --git a/configure.ac b/configure.ac
index 4ba59c13e7..da4222a87a 100644
--- a/configure.ac
+++ b/configure.ac
@@ -108,7 +108,6 @@ AC_CONFIG_FILES([Makefile
                  anaconda.spec
                  data/Makefile
                  data/command-stubs/Makefile
-                 docs/Makefile
                  dracut/Makefile
                  dracut/dd/Makefile
                  data/conf.d/Makefile
@@ -121,7 +120,6 @@ AC_CONFIG_FILES([Makefile
                  data/pam/Makefile
                  data/window-manager/Makefile
                  data/window-manager/config/Makefile
-                 po/Makefile
                  scripts/Makefile
                  pyanaconda/Makefile
                  pyanaconda/version.py
diff --git a/widgets/Makefile.am b/widgets/Makefile.am
index 2da4157dc5..e5ca3506f1 100644
--- a/widgets/Makefile.am
+++ b/widgets/Makefile.am
@@ -19,7 +19,7 @@
 
 ACLOCAL_AMFLAGS = -I m4
 
-SUBDIRS = src python @GLADE_SUBDIR@ doc
+SUBDIRS = src python @GLADE_SUBDIR@
 
 MAINTAINERCLEANFILES = Makefile.in aclocal.m4 config.guess config.h.in config.sub \
 	configure depcomp install-sh ltmain.sh missing py-compile \
-- 
2.7.4

