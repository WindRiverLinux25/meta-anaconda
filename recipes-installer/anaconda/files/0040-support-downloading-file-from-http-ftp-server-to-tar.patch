@@ -159,8 +258,14 @@ class AnacondaKickstartSpecification(KickstartSpecification):
         "poweroff": COMMANDS.Reboot,
         "reboot": COMMANDS.Reboot,
         "shutdown": COMMANDS.Reboot,
+        "download": Download,
     }
 
